{
  "name": "localinference",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local Inference — průvodce lokální AI na hotových zařízeních",
  "scripts": {
    "check": "npm run check:data && npm run check:obsah && npm run check:chybi",
    "check:data": "node scripts/kontrola-dat.mjs",
    "check:obsah": "node scripts/kontrola-obsahu.mjs",
    "check:chybi": "node scripts/chybi.mjs --kontrola",
    "check:zdroje": "node scripts/kontrola-zdroju.mjs",
    "chybi": "node scripts/chybi.mjs",
    "chybi:zapis": "node scripts/chybi.mjs --zapis",
    "objevy": "node scripts/objevy.mjs",
    "parita": "node scripts/parita.mjs",
    "hlidac": "node scripts/hlidac.mjs",
    "dev": "npm --prefix sites/cz run dev",
    "build": "npm run check && npm --prefix sites/cz run build && npm run check:odkazy",
    "check:odkazy": "node scripts/kontrola-odkazu.mjs",
    "check:odkazy:en": "node scripts/kontrola-odkazu.mjs sites/eu/dist"
  },
  "devDependencies": {
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "zod": "^3.23.8"
  }
}
