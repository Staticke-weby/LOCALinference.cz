---
import { formatDatum, getZmeny, relOdkazu } from '../lib/data';

const zmeny = getZmeny();

const typLabel: Record<string, string> = {
  cena: 'cena',
  model: 'model',
  mereni: 'měření',
  zdroj: 'zdroj',
  obsah: 'obsah',
};

const LEGACY: Record<string, string> = {
  'zarizeni': 'zarizeni/srovnani',
  'modely': 'modely/qwen3-8-flash-next',
  'zaciname': 'zaciname/co-je-lokalni-ai',
  'zaciname/slovnik': 'slovnik',
  'zaciname/co-je-ttft': 'slovnik/vykon/ttft',
  'zaciname/co-je-prefill': 'slovnik/vykon/prefill',
  'zaciname/co-je-soubeznost': 'slovnik/vykon/soubeznost',
  'zaciname/co-je-paralelizace': 'slovnik/vykon/paralelizace',
  'zaciname/co-je-power-limit': 'slovnik/provoz/power-limit',
  'zaciname/co-je-throttling': 'slovnik/provoz/throttling',
  'zaciname/co-je-cuda': 'slovnik/software/cuda',
  'zaciname/co-je-rocm': 'slovnik/software/rocm',
  'zaciname/co-je-vllm': 'slovnik/software/vllm',
  'zaciname/co-je-llamacpp': 'slovnik/software/llamacpp',
};

function odkazStranky(stranka: string): string {
  const cil = LEGACY[stranka] ?? stranka;
  if (cil === 'index' || cil === '/' || cil === '') return '/';
  if (cil.startsWith('/')) return cil;
  return `/${cil.replace(/\/$/, '')}/`;
}

function popisStranky(stranka: string): string {
  const cil = LEGACY[stranka] ?? stranka;
  const nazvy: Record<string, string> = {
    'index': 'Domovská stránka',
    'zaciname': 'Začínáme',
    'zaciname/co-je-lokalni-ai': 'Co je lokální AI',
    'zaciname/jak-to-funguje': 'Jak to funguje',
    'zaciname/jak-cteme-data': 'Jak čteme data',
    'zaciname/faq': 'Časté dotazy',
    'zaciname/proc-moe': 'Proč MoE',
    'rychlost/roofline': 'Roofline',
    'vyber/rozpocet': 'Výběr podle rozpočtu',
    'vyber/kolik-uzivatelu': 'Kolik uživatelů',
    'zarizeni': 'Srovnání zařízení',
    'zarizeni/ai-boxy': 'AI boxy',
    'zarizeni/ai-notebooky': 'AI notebooky',
    'zarizeni/dgx-spark': 'DGX Spark',
    'zarizeni/rtx-spark-mini': 'RTX Spark mini',
    'zarizeni/rtx-spark-notebook': 'RTX Spark notebook',
    'zarizeni/rtx-spark-notebook-oem': 'RTX Spark notebook OEM',
    'zarizeni/strix-halo': 'Strix Halo',
    'zarizeni/strix-halo-oem': 'Strix Halo OEM',
    'zarizeni/dgx-spark-oem': 'DGX Spark OEM',
    'zarizeni/mac-studio': 'Mac Studio',
    'zarizeni/macbook-pro': 'MacBook Pro',
    'zarizeni/srovnani': 'Srovnání zařízení',
    'modely': 'Qwen3.8 Flash Next',
    'modely/proc-moe': 'Proč MoE',
    'modely/qwen3-8-flash-next': 'Qwen3.8 Flash Next',
    'data/qwen3-8-flash-next-strix-halo': 'Data: Qwen3.8 FN na Strix Halo',
    'navody': 'Návody',
    'navody/dgx-spark': 'Návod DGX Spark',
    'navody/mac': 'Návod Mac',
    'generovani': 'Generování',
    'generovani/3d': 'Generování 3D',
    'generovani/audio': 'Generování audia',
    'generovani/obrazky': 'Generování obrázků',
    'generovani/video': 'Generování videa',
    'generovani/licence': 'Licence generování',
    'generovani/preklady': 'Překlady',
    'generovani/recepty': 'Recepty',
    'temata': 'Témata',
    'temata/cena-lokalni-ai': 'Cena lokální AI',
    'temata/lokalni-ai-na-windows-11': 'Lokální AI na Windows 11',
    'o-webu/metodika': 'Metodika',
    'o-webu/jak-piseme': 'Jak píšeme',
    'o-webu/pravni': 'Právní informace',
    'zdroje/zdroje': 'Zdroje',
    'zdroje/mereni': 'Všechna měření',
    'zdroje/co-nevime': 'Co nevíme',
    'zdroje/novinky': 'Novinky',
    'slovnik': 'Slovník',
    'slovnik/vykon/ttft': 'TTFT',
    'slovnik/vykon/prefill': 'Prefill',
    'slovnik/vykon/soubeznost': 'Souběžnost',
    'slovnik/vykon/paralelizace': 'Paralelizace',
    'slovnik/vykon/decode': 'Decode',
    'slovnik/vykon/propustnost-pameti': 'Propustnost paměti',
    'slovnik/vykon/tflops': 'TFLOPS',
    'slovnik/pamet/kontext': 'Kontext',
    'slovnik/pamet/unified-memory': 'Unified memory',
    'slovnik/provoz/power-limit': 'Power limit',
    'slovnik/provoz/throttling': 'Throttling',
    'slovnik/software/cuda': 'CUDA',
    'slovnik/software/rocm': 'ROCm',
    'slovnik/software/vllm': 'vLLM',
    'slovnik/software/llamacpp': 'llama.cpp',
    'slovnik/software/huggingface': 'Hugging Face',
    'slovnik/software/mtp': 'MTP',
    'slovnik/software/nvfp4': 'NVFP4',
    'slovnik/software/ollama': 'Ollama',
  };
  if (nazvy[cil]) return nazvy[cil];
  const casti = cil.split('/');
  return casti[casti.length - 1].replace(/-/g, ' ');
}
---

<ol class="li-zmeny">
  {zmeny.map((z) => (
    <li class="li-zmena">
      <div class="li-zmena__hlava">
        <time datetime={z.datum instanceof Date ? z.datum.toISOString().slice(0, 10) : String(z.datum)}>
          {formatDatum(z.datum)}
        </time>
        <span class={`li-zmena__typ li-zmena__typ--${z.typ}`}>{typLabel[z.typ] ?? z.typ}</span>
      </div>
      <h3>{z.titulek}</h3>
      <p>{z.co_se_zmenilo}</p>
      <div class="li-zmena__patka">
        {z.dotcene_stranky.length > 0 && (
          <span class="li-zmena__stranky">
            Dotčeno:{' '}
            {z.dotcene_stranky.map((s, i) => (
              <span>
                <a href={odkazStranky(s)}>{popisStranky(s)}</a>
                {i < z.dotcene_stranky.length - 1 ? ', ' : ''}
              </span>
            ))}
          </span>
        )}
        <a href={z.zdroj} target="_blank" rel={relOdkazu(z.zdroj)}>zdroj</a>
      </div>
    </li>
  ))}
</ol>

<style>
  .li-zmeny {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: grid;
    gap: 0.8rem;
  }
  .li-zmena {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    padding: 0.85rem 1rem;
  }
  .li-zmena__hlava {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-3);
  }
  .li-zmena__typ {
    display: inline-block;
    padding: 0.02rem 0.45rem;
    border-radius: 999px;
    border: 1px solid var(--sl-color-gray-5);
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-2);
  }
  .li-zmena__typ--cena {
    border-color: var(--li-gold);
    color: var(--li-gold-high);
    background: var(--li-gold-low);
  }
  .li-zmena__typ--model,
  .li-zmena__typ--mereni {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-accent-high);
    background: var(--sl-color-accent-low);
  }
  .li-zmena h3 {
    margin: 0.35rem 0 0.25rem;
    font-size: var(--sl-text-lg);
  }
  .li-zmena p {
    margin: 0 0 0.5rem;
    color: var(--sl-color-gray-2);
  }
  .li-zmena__patka {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
  .li-zmena__stranky a {
    color: var(--sl-color-accent);
  }
</style>
