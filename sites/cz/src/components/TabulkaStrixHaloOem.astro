---
import { formatCislo, formatKc, getStrixHaloOem, relOdkazu } from '../lib/data';

const stroje = getStrixHaloOem();
---

<div class="li-tabulka-obal">
  <table class="li-tabulka">
    <thead>
      <tr>
        <th>Stroj</th>
        <th>Výrobce</th>
        <th>Paměť</th>
        <th>Úložiště</th>
        <th>Cena vč. DPH</th>
        <th>Cena bez DPH</th>
        <th>Dostupnost</th>
      </tr>
    </thead>
    <tbody>
      {stroje.map((s, i) => (
        <tr class={i === 0 && s.cena_czk_s_dph != null ? 'li-nejlevnejsi' : undefined}>
          <td>
            <a href={s.zdroj} target="_blank" rel={relOdkazu(s.zdroj)}>{s.nazev}</a>
            {i === 0 && s.cena_czk_s_dph != null ? <span class="li-stitek">nejlevnější</span> : null}
            {s.objednaci_kod ? <span class="li-pozn"> · {s.objednaci_kod}</span> : null}
          </td>
          <td>{s.vyrobce}</td>
          <td class="li-cislo">{formatCislo(s.pamet_gb)} GB</td>
          <td class="li-cislo">{formatCislo(s.uloziste_gb / 1024)} TB</td>
          <td class="li-cislo">
            {s.cena_czk_s_dph != null ? `${formatKc(s.cena_czk_s_dph)} Kč` : '—'}
          </td>
          <td class="li-cislo">
            {s.cena_czk_bez_dph != null ? `${formatKc(s.cena_czk_bez_dph)} Kč` : '—'}
          </td>
          <td>{s.dostupnost}</td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .li-tabulka-obal {
    overflow-x: auto;
  }
  .li-nejlevnejsi {
    background: var(--li-gold-low, rgba(205, 127, 50, 0.08));
  }
  .li-stitek {
    display: inline-block;
    margin-left: 0.4rem;
    padding: 0.02rem 0.45rem;
    border-radius: 999px;
    border: 1px solid var(--li-gold);
    color: var(--li-gold-high);
    font-size: var(--sl-text-xs);
    vertical-align: middle;
  }
</style>
