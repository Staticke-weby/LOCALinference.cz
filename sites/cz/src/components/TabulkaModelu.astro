---
import { formatCislo, getModely } from '../lib/data';

interface Props {
  filtr?: string[];
}

const { filtr } = Astro.props;
const vse = getModely();
const modely = filtr ? vse.filter((m) => filtr.includes(m.id)) : vse;
---

<div class="li-tabulka-obal">
  <table class="li-tabulka">
    <thead>
      <tr>
        <th>Model</th>
        <th>Celkem / aktivní</th>
        <th>Kontext max</th>
        <th>Vision</th>
        <th>Licence</th>
        <th>Stav</th>
        <th>Zdroj</th>
      </tr>
    </thead>
    <tbody>
      {modely.map((m) => (
        <tr>
          <td>{m.stranka ? <a href={m.stranka}>{m.nazev}</a> : m.nazev}</td>
          <td class="li-cislo">{formatCislo(m.parametry_celkem_b)} / {formatCislo(m.parametry_aktivni_b)} B</td>
          <td class="li-cislo">{m.kontext.max ? formatCislo(m.kontext.max) : '—'}</td>
          <td>{m.vision ? 'ano' : 'ne'}</td>
          <td>{m.licence}</td>
          <td>{m.stav}</td>
          <td><a href={m.zdroje[0]} target="_blank" rel="noopener noreferrer">zdroj</a></td>
        </tr>
      ))}
    </tbody>
  </table>
</div>

<style>
  .li-tabulka-obal {
    overflow-x: auto;
  }
</style>
