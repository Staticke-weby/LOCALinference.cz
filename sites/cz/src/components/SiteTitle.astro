---
// Logo v hlavičce: [Li] LOCALinference. Textové, takže drží kontrast
// v obou motivech a nemění se při zoomu. Stejná logika jako u OpenWork.cz.
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a
  href={siteTitleHref}
  class="li-logo"
  aria-label={`${siteTitle} — úvodní stránka`}
>
  <span class="li-logo__tag" aria-hidden="true">
    <span class="li-logo__brk">[</span><span class="li-logo__li">Li</span><span class="li-logo__brk">]</span>
  </span>
  <span class="li-logo__word" aria-hidden="true">
    <span class="li-logo__local">LOCAL</span><span class="li-logo__inf">inference</span>
  </span>
</a>

<style>
  .li-logo {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45rem;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    min-width: 0;
  }
  .li-logo__tag {
    font-family: var(--sl-font-mono);
    font-size: 1.02rem;
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .li-logo__brk {
    color: var(--sl-color-accent);
  }
  .li-logo__li {
    color: var(--li-gold);
  }
  .li-logo__word {
    font-size: 1.28rem;
    letter-spacing: -0.025em;
  }
  .li-logo__local {
    color: var(--sl-color-white);
    font-weight: 800;
  }
  .li-logo__inf {
    color: var(--sl-color-gray-2);
    font-weight: 400;
  }
  @media (max-width: 26rem) {
    .li-logo {
      gap: 0.3rem;
    }
    .li-logo__tag {
      font-size: 0.92rem;
    }
    .li-logo__word {
      font-size: 1.05rem;
    }
  }
</style>
