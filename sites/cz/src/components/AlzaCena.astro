---
// Odkaz na rozcestník "Kde koupit". Affiliate odkazy na prodejce jsou
// jen tam; odsud vede interní odkaz, aby se prodejní odkaz neopakoval
// na každé stránce webu.
interface Props {
  kategorie?: 'boxy' | 'notebooky' | 'rtx-spark-pocitace' | 'mac' | 'macbooky';
  text?: string;
}

const { kategorie = 'boxy', text = 'Ceny a dostupnost u prodejců' } = Astro.props;

const KOTVY = {
  boxy: 'ai-boxy',
  notebooky: 'rtx-spark-notebooky',
  'rtx-spark-pocitace': 'rtx-spark-stolni',
  mac: 'apple',
  macbooky: 'apple',
} as const;

const href = `/kde-koupit/#${KOTVY[kategorie]}`;
---

<p class="li-alza">
  <a href={href}>
    {text}
    <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M5 12h14M13 6l6 6-6 6"></path>
    </svg>
  </a>
</p>

<style>
  .li-alza {
    margin: 0.9rem 0 1.2rem;
  }
  .li-alza a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 1.05rem;
    border: 1px solid transparent;
    border-radius: 999px;
    background: var(--sl-color-accent);
    color: var(--li-btn-text);
    font-size: var(--sl-text-sm);
    font-weight: 600;
    text-decoration: none;
    transition: background 150ms ease, transform 150ms ease;
  }
  .li-alza a:hover {
    background: var(--sl-color-accent-high);
    transform: translateY(-1px);
  }
  .li-alza svg {
    flex: none;
  }
</style>
