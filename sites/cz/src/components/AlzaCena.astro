---
// Odkaz na aktuální ceny v kategorii Alza.cz. Vždy affiliate,
// vždy na kategorii — konkrétní produkt se mění a vyprodává.
import { relOdkazu } from '../lib/data';

interface Props {
  kategorie?: 'boxy' | 'notebooky' | 'mac';
  text?: string;
}

const { kategorie = 'boxy', text = 'Aktuální ceny na Alza.cz' } = Astro.props;

const URLS = {
  boxy: 'https://www.alza.cz/ai-pc/18907789.htm?idp=12510&banner_id=41939',
  notebooky: 'https://www.alza.cz/rtx-spark/18924563.htm?idp=12510&banner_id=41939',
  mac: 'https://www.alza.cz/mac-studio/18894763.htm?idp=12510&banner_id=41939',
} as const;

const href = URLS[kategorie];
---

<p class="li-alza">
  <a href={href} target="_blank" rel={relOdkazu(href)}>{text}</a>
  <span class="li-alza__stitek">affiliate</span>
</p>

<style>
  .li-alza {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin: 0.85rem 0 1.1rem;
    font-size: var(--sl-text-sm);
  }
  .li-alza a {
    font-weight: 600;
  }
  .li-alza__stitek {
    padding: 0.05rem 0.45rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    font-size: var(--sl-text-2xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }
</style>
