---
import {
  getMereni,
  nazevZarizeni,
  mereniRychlost,
  typLabel,
  merenoKymLabel,
  duveryhodnostLabel,
  formatDatum,
  formatCislo,
} from '../lib/data';

const mereni = getMereni();

const zarizeni = [...new Set(mereni.map((m) => m.zarizeni))].sort((a, b) =>
  nazevZarizeni(a).localeCompare(nazevZarizeni(b), 'cs'),
);

type Bod = { id: string; nazev: string; min: number; max: number; median: number };

const body: Bod[] = [];
for (const id of zarizeni) {
  const hodnoty: number[] = [];
  for (const m of mereni.filter((x) => x.zarizeni === id)) {
    if (m.rozptyl) {
      hodnoty.push(m.rozptyl.min, m.rozptyl.max);
    } else if (m.decode_toks != null) {
      hodnoty.push(m.decode_toks);
    }
  }
  if (!hodnoty.length) continue;
  hodnoty.sort((a, b) => a - b);
  const stred = Math.floor(hodnoty.length / 2);
  body.push({
    id,
    nazev: nazevZarizeni(id),
    min: hodnoty[0],
    max: hodnoty[hodnoty.length - 1],
    median:
      hodnoty.length % 2 ? hodnoty[stred] : (hodnoty[stred - 1] + hodnoty[stred]) / 2,
  });
}
body.sort((a, b) => b.max - a.max);

const maxHodnota = Math.max(10, Math.ceil(Math.max(...body.map((b) => b.max)) / 10) * 10);
const sirka = 640;
const vyska = body.length * 38 + 30;
const levy = 170;
const pravy = 620;

const x = (v: number) => levy + (v / maxHodnota) * (pravy - levy);
---

<div class="li-obal">
  <div class="li-filtr">
    <label for="filtr-mereni">Zařízení:</label>
    <select id="filtr-mereni">
      <option value="">všechna</option>
      {zarizeni.map((id) => <option value={id}>{nazevZarizeni(id)}</option>)}
    </select>
    <span class="li-pozn" id="filtr-pocet">{mereni.length} měření</span>
  </div>

  <div class="li-tabulka-obal">
    <table class="li-tabulka" id="tabulka-mereni">
      <thead>
        <tr>
          <th>Zařízení</th>
          <th>Datum</th>
          <th>Model</th>
          <th>Kvantizace</th>
          <th>Engine</th>
          <th>Kontext</th>
          <th>Decode</th>
          <th>Prefill</th>
          <th>TTFT</th>
          <th>Sběh.</th>
          <th>Měřil</th>
          <th>Dův.</th>
          <th>Zdroj</th>
        </tr>
      </thead>
      <tbody>
        {mereni.map((m) => (
          <tr data-zarizeni={m.zarizeni}>
            <td>{nazevZarizeni(m.zarizeni)}</td>
            <td>{formatDatum(m.datum)}</td>
            <td>{m.model}</td>
            <td>{m.kvantizace}</td>
            <td>
              {m.engine}
              {m.engine_verze ? <span class="li-pozn"> · {m.engine_verze}</span> : null}
            </td>
            <td>{m.kontext != null ? `${formatCislo(m.kontext / 1024)}k` : '—'}</td>
            <td>{mereniRychlost(m)}</td>
            <td>{m.prefill_toks != null ? `${formatCislo(m.prefill_toks)} tok/s` : '—'}</td>
            <td>{m.ttft_ms != null ? `${formatCislo(m.ttft_ms)} ms` : '—'}</td>
            <td>{m.soubeznost}</td>
            <td>{merenoKymLabel(m.mereno_kym)}</td>
            <td>{duveryhodnostLabel(m.duveryhodnost)}</td>
            <td>
              <a href={m.zdroj} target="_blank" rel="noopener noreferrer">zdroj</a>
              <span class="li-pozn"> · {typLabel(m.typ)}</span>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h3>Decode podle zařízení</h3>
  <p class="li-pozn">
    Rozsah všech měření v tabulce, čára uprostřed je medián. Různá kvantizace
    a kontexty se sčítají do jednoho pruhu, proto slouží k orientaci, ne
    k porovnání výkonu za stejných podmínek.
  </p>
  <div class="li-tabulka-obal">
    <svg
      viewBox={`0 0 ${sirka} ${vyska}`}
      width="100%"
      style="max-width:760px;height:auto"
      role="img"
      aria-label="Rozsah decode v tok/s podle zařízení"
    >
      <line x1={levy} y1="8" x2={levy} y2={vyska - 18} stroke="currentColor" />
      {[0, maxHodnota / 2, maxHodnota].map((t) => (
        <>
          <line x1={x(t)} y1="8" x2={x(t)} y2={vyska - 18} stroke="currentColor" stroke-dasharray="3 4" opacity="0.4" />
          <text x={x(t)} y={vyska - 4} text-anchor="middle" fill="currentColor" font-size="11">
            {formatCislo(t)}
          </text>
        </>
      ))}
      {body.map((b, i) => {
        const y = 14 + i * 38;
        return (
          <>
            <text x={levy - 10} y={y + 16} text-anchor="end" fill="currentColor" font-size="12">
              {b.nazev}
            </text>
            <rect x={x(b.min)} y={y + 4} width={Math.max(1, x(b.max) - x(b.min))} height="18" rx="3" fill="currentColor" opacity="0.25" />
            <line x1={x(b.median)} y1={y + 1} x2={x(b.median)} y2={y + 25} stroke="currentColor" stroke-width="2" />
            <text x={x(b.max) + 6} y={y + 17} fill="currentColor" font-size="11">
              {formatCislo(b.min)}–{formatCislo(b.max)}
            </text>
          </>
        );
      })}
      <text x={pravy} y={vyska - 4} text-anchor="end" fill="currentColor" font-size="11">
        tok/s
      </text>
    </svg>
  </div>
</div>

<script>
  const filtr = document.getElementById('filtr-mereni');
  const tabulka = document.getElementById('tabulka-mereni');
  const pocet = document.getElementById('filtr-pocet');
  if (filtr && tabulka) {
    filtr.addEventListener('change', () => {
      const hodnota = filtr.value;
      let videt = 0;
      tabulka.querySelectorAll('tbody tr').forEach((radek) => {
        const shoda = !hodnota || radek.dataset.zarizeni === hodnota;
        radek.hidden = !shoda;
        if (shoda) videt += 1;
      });
      if (pocet) pocet.textContent = videt + ' měření';
    });
  }
</script>

<style>
  .li-obal {
    margin: 1rem 0 1.5rem;
  }
  .li-filtr {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }
  .li-filtr select {
    padding: 0.3rem 0.4rem;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 4px;
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
  }
  .li-tabulka-obal {
    overflow-x: auto;
  }
</style>
