---
import Default from '@astrojs/starlight/components/Footer.astro';
---

<Default {...Astro.props}><slot /></Default>

<div class="li-nezavislost">
  <p>
    LOCALinference is an independent guide. We are not affiliated with
    manufacturers or retailers. Figures come from public sources and are
    always attributed.
    <span class="li-oddelovac">·</span>
    <a href="/about/">About</a>
    <span class="li-oddelovac">·</span>
    <a href="/devices/">Devices</a>
    <span class="li-oddelovac">·</span>
    <a href="/models/qwen3-8-flash-next/">Model</a>
    <span class="li-oddelovac">·</span>
    <a href="https://www.localinference.cz/">Čeština</a>
  </p>
  <p class="li-provozovatel">
    Operated by ESHOpino s.r.o., Company ID 03223485, Prague, Czech Republic.
  </p>
</div>

<style>
  .li-nezavislost {
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--sl-color-gray-5);
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
  .li-nezavislost a {
    color: var(--sl-color-accent);
  }
  .li-oddelovac {
    margin: 0 0.35em;
    color: var(--sl-color-gray-4);
  }
  .li-provozovatel {
    margin: 0.4rem 0 0;
    font-size: var(--sl-text-xs);
    color: var(--sl-color-gray-3);
  }
</style>
