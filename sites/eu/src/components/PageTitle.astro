---
// Page title + last verified date (frontmatter `last_verified`) and a link
// to the other language version.
import Default from '@astrojs/starlight/components/PageTitle.astro';
import Jazyk from './Jazyk.astro';

const data = Astro.locals.starlightRoute.entry.data as {
  last_verified?: Date;
};
const lastVerified = data.last_verified;
const dateFormat = new Intl.DateTimeFormat('en-US', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<Default><slot /></Default>
<div class="li-pod-nadpisem">
  {
    lastVerified instanceof Date && !Number.isNaN(lastVerified.getTime()) ? (
      <span class="li-overeno">
        Last verified: {dateFormat.format(lastVerified)}
      </span>
    ) : null
  }
  <Jazyk />
</div>

<style>
  .li-pod-nadpisem {
    margin-top: 0.45rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.6rem;
    font-size: var(--sl-text-sm);
  }
  .li-overeno {
    color: var(--sl-color-gray-3);
  }
</style>
